[Unit]
Description=GT Question Generator 2.0
After=network.target

[Service]
Type=simple
User=gt-generator
Group=gt-generator
WorkingDirectory=/opt/gt-question-generator
Environment=PATH=/opt/gt-question-generator/venv/bin
Environment=FLASK_HOST=0.0.0.0
Environment=FLASK_PORT=5000
Environment=FLASK_ENV=production
ExecStart=/opt/gt-question-generator/venv/bin/python start_production.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gt-question-generator/logs /opt/gt-question-generator/app/static/images

[Install]
WantedBy=multi-user.target 